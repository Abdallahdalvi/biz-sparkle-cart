# Self-hosted Supabase (dalvi.cloud)
VITE_SUPABASE_URL=https://supabase.dalvi.cloud
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Server-only (used by createServerFn handlers)
SUPABASE_URL=https://supabase.dalvi.cloud
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional but recommended: stable secret used to encrypt the private LLP tracker payload.
# Generate a long random value and keep it server-only. If omitted, the service-role key is used.
BUSINESS_TRACKER_ENCRYPTION_KEY=

# Cashfree Payments (server-only; use sandbox until Cashfree activates production access)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
# Public origin used in Cashfree return and webhook URLs.
PUBLIC_SITE_URL=https://aghanimsphones.in

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Optional — defaults to "Primary" (must exist in your Shiprocket dashboard)
SHIPROCKET_PICKUP_LOCATION=Primary

# New order admin alerts
# Email alerts use Resend's HTTPS API. Set both values to enable email notifications.
RESEND_API_KEY=
ADMIN_ORDER_NOTIFICATION_EMAIL=
# Use a verified sender on your domain when you move beyond Resend sandbox/testing.
ORDER_NOTIFICATION_FROM_EMAIL="Aghanims Orders <onboarding@resend.dev>"
# Optional: send the same alert JSON to ntfy, Discord/Slack proxy, etc.
ADMIN_ORDER_NOTIFICATION_WEBHOOK_URL=
